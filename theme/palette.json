{
  "_meta": {
    "note": "Single source of truth for colour. theme/tokens.ts and global.css read this file; run `npm run theme` after editing.",
    "overrides": {
      "text.secondary": "#655B81 rather than #77727D, which is 4.40:1 on the canvas and fails AA for body text.",
      "border.input": "#9D86B8, the lightest lilac that reaches 3:1 for a UI boundary.",
      "brandViolet": "#8759C0, darkened slightly from the rendered brand violet to reach 4.68:1 (AA) as text.",
      "border": "#D8C9E8 (Lavender Border), used for card and glass boundaries.",
      "textPlaceholder": "#524C6B, one step lighter than body text so an empty field reads as a prompt while staying well above AA.",
      "textStrong": "#1A1720, for Michroma screen titles only."
    },
    "launchTheme": "light. The first release ships light mode only; the dark set is complete and contrast-checked but not exposed. See LIGHT_ONLY_LAUNCH in theme/config.ts."
  },
