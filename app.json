{
  "expo": {
    "name": "SAOHLIN",
    "slug": "saohlin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.saohlin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCD5DA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saohlin.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCD5DA",
          "image": "./assets/brand/launch-logo.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/brand/launch-screen.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "backgroundColor": "#DCD5DA"
          }
        }
      ]
    ],
    "scheme": "saohlin",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#DCD5DA"
  }
}
